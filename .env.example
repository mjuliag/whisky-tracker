# Carrefour scheduled-delivery postcode, for example: 1428
CARREFOUR_POSTAL_CODE=
WHISKY_TRACKER_DB_PATH=

# Optional alert thresholds; omitted values use 10%, 10%, and 25% respectively.
MINIMUM_PRICE_DROP_PERCENTAGE=
MINIMUM_CROSS_RETAILER_DIFFERENCE_PERCENTAGE=
MINIMUM_PROMOTION_DISCOUNT_PERCENTAGE=
MAX_NOTIFICATIONS_PER_RUN=

# Mercado Libre developer application credentials. Keep real values in .env only.
MERCADOLIBRE_ACCESS_TOKEN=
MERCADOLIBRE_REFRESH_TOKEN=
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# Telegram Bot API credentials. Keep real values in .env only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
